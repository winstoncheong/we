{
  "name": "we-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node -e \"const fs=require('node:fs');const d='dist/assets';if(fs.existsSync(d))for(const f of fs.readdirSync(d))if(f.startsWith('highlight.worker-'))fs.renameSync(d+'/'+f,'dist/'+f)\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.11.0",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.5",
    "@pierre/diffs": "^1.6.2",
    "@pierre/highlights": "^0.3.0",
    "@pierre/theme": "^2.0.0",
    "@pierre/theming": "^1.0.2",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "htmx.org": "^2.0.11",
    "markdown-it": "^14.3.3",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.15"
  }
}
